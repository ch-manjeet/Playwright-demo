# .gitignore for Playwright / Node.js projects

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log

# Playwright
playwright-report/
test-results/
.traces/
.playwright/
artifacts/
trace.zip

# Build outputs
dist/
build/
out/

# Logs
logs/
*.log

# Environment files
.env
.env.local
.env.*.local
.env.staging
.env.production


# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors/IDEs
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln
*.swp

# Python (if present)
__pycache__/
*.py[cod]
venv/
.envrc
.pytest_cache/

# Coverage
coverage/
coverage-final.json
.nyc_output/

# TypeScript
*.tsbuildinfo

# Misc
*.bak
*.tmp
*.temp
*.orig